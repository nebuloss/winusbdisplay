<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B1E9B3A4-7C42-4B18-9E55-2A3F6D8C1047}</ProjectGuid>
    <RootNamespace>ms912xidd</RootNamespace>
    <TargetName>ms912xidd</TargetName>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <TargetVersion>Windows10</TargetVersion>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <DriverType>UMDF</DriverType>
    <!-- The WDK reads UmdfVersion, not the UmdfVersionMajor/Minor pair that
         older templates use. Getting this wrong fails with a confusing
         "unsupported property value '.'" error. -->
    <UmdfVersion>2.33</UmdfVersion>
    <UMDF_VERSION_MAJOR>2</UMDF_VERSION_MAJOR>
    <UMDF_VERSION_MINOR>33</UMDF_VERSION_MINOR>
    <!-- The IddCx client stub is what makes this an indirect display driver. -->
    <IddCxVersion>1.4</IddCxVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\driver\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\driver\obj\$(Platform)\$(Configuration)\</IntDir>
    <SdkIddCxInc>$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\um\iddcx\$(IddCxVersion)</SdkIddCxInc>
    <SdkIddCxLib>$(WindowsSdkDir)Lib\$(WindowsTargetPlatformVersion)\um\$(Platform)\iddcx\$(IddCxVersion)</SdkIddCxLib>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions>_UNICODE;UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(SdkIddCxInc);$(SolutionDir)src\common;$(SolutionDir)src\driver;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(SdkIddCxLib)\IddCxStub.lib;d3d11.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <TimeStampServer>http://timestamp.digicert.com</TimeStampServer>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="..\common\ms912x_proto.cpp" />
    <ClCompile Include="..\common\ms912x_convert.cpp" />
    <ClCompile Include="..\common\ms912x_device.cpp" />
    <ClCompile Include="..\common\transport.cpp" />
    <ClCompile Include="usb_backend.cpp" />
    <ClCompile Include="device.cpp" />
    <ClCompile Include="driver.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="..\common\ms912x_proto.h" />
    <ClInclude Include="..\common\ms912x_convert.h" />
    <ClInclude Include="..\common\ms912x_device.h" />
    <ClInclude Include="..\common\transport.h" />
    <ClInclude Include="usb_backend.h" />
    <ClInclude Include="device.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="..\..\inf\ms912x_iddcx.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
