; SPDX-License-Identifier: GPL-2.0-only
;
; Indirect display driver for MacroSilicon MS912x / MS913x USB display
; adapters. This is a UMDF2 driver using the IddCx class extension; it binds
; to the vendor specific display interface of the dongle and talks to it over
; the WDF USB target (WinUsb dispatcher).
;
; Install this OR inf/ms912x_winusb.inf, not both: they claim the same
; interface. The WinUSB one is for the standalone msdisp bring-up tool.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = ms912xidd.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
ms912xidd.dll = 1

[Manufacturer]
%ManufacturerName% = Standard, NTamd64.10.0...16299, NTarm64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceName% = MS912xIdd_Install, USB\VID_345F&PID_9132&MI_03
%DeviceName% = MS912xIdd_Install, USB\VID_345F&PID_9133&MI_03
%DeviceName% = MS912xIdd_Install, USB\VID_345F&PID_9135&MI_03
%DeviceName% = MS912xIdd_Install, USB\VID_534D&PID_6021
%DeviceName% = MS912xIdd_Install, USB\VID_534D&PID_0821

[Standard.NTarm64.10.0...16299]
%DeviceName% = MS912xIdd_Install, USB\VID_345F&PID_9132&MI_03
%DeviceName% = MS912xIdd_Install, USB\VID_345F&PID_9133&MI_03
%DeviceName% = MS912xIdd_Install, USB\VID_345F&PID_9135&MI_03
%DeviceName% = MS912xIdd_Install, USB\VID_534D&PID_6021
%DeviceName% = MS912xIdd_Install, USB\VID_534D&PID_0821

[MS912xIdd_Install]
CopyFiles = MS912xIdd_CopyFiles

[MS912xIdd_CopyFiles]
ms912xidd.dll

[MS912xIdd_Install.HW]
AddReg = MS912xIdd_HwAddReg

[MS912xIdd_HwAddReg]
HKR,,"UpperFilters",0x00010000,"IndirectKmd"
HKR,,"DeviceInterfaceGUIDs",0x10000,"{6C2C4F1E-3B7A-4D4F-9F2E-5A1B8C7D3E90}"

[MS912xIdd_Install.Services]
AddService = WUDFRd, 0x000001fa, WUDFRD_ServiceInstall
; UmdfDispatcher = WinUsb means WinUSB.sys sits underneath this driver and
; services the USB requests. It has to be installed as a service here, or
; WdfUsbTargetDeviceCreateWithParameters fails and the device never starts
; (problem code 10). WinUSB.sys is in-box, so nothing needs copying.
AddService = WinUsb, 0x000001f8, WinUsb_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\WUDFRd.sys
LoadOrderGroup = Base

[WinUsb_ServiceInstall]
DisplayName   = %WinUsbDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[MS912xIdd_Install.Wdf]
UmdfService              = ms912xidd, MS912xIdd_UmdfInstall
UmdfServiceOrder         = ms912xidd
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy     = AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy   = CannotUseFsContexts

[MS912xIdd_UmdfInstall]
UmdfLibraryVersion = 2.33.0
ServiceBinary      = %13%\ms912xidd.dll
UmdfExtensions     = IddCx0102
; The driver reaches the dongle through the WinUsb dispatcher rather than
; owning a kernel USB stack of its own.
UmdfDispatcher     = WinUsb

[Strings]
ProviderName      = "winusbdisplay"
ManufacturerName  = "MacroSilicon"
DeviceName        = "MacroSilicon USB Display (indirect display driver)"
DiskName          = "MacroSilicon USB Display Installation Disk"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
