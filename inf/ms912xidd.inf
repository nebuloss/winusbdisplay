; SPDX-License-Identifier: GPL-2.0-only
;
; Indirect display driver for MacroSilicon MS912x / MS913x USB display
; adapters. UMDF2 + IddCx.
;
; This is a ROOT-ENUMERATED software device, not a driver bound to the USB
; interface, which is how every shipping IddCx driver is built (see the in-box
; rdpidd.inf and miradisp.inf). The reason is that IddCx needs the IndirectKmd
; upper filter, and that topology is incompatible with UmdfDispatcher = WinUsb;
; a driver bound to the USB interface fails to create its USB target and never
; starts.
;
; Instead the driver reaches the dongle from user mode, exactly as the msdisp
; tool does: the control plane over the HID interface, and the pixel pipe over
; the WinUSB interface bound by inf\ms912x_winusb.inf. So BOTH packages must be
; installed for the monitor to work.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = ms912xidd.cat
DriverVer   = 01/01/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
ms912xidd.dll = 1

[Manufacturer]
%ManufacturerName% = Standard, NTamd64.10.0...16299, NTarm64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceName% = MS912xIdd_Install, root\ms912xidd

[Standard.NTarm64.10.0...16299]
%DeviceName% = MS912xIdd_Install, root\ms912xidd

[MS912xIdd_Install]
CopyFiles = MS912xIdd_CopyFiles

[MS912xIdd_CopyFiles]
ms912xidd.dll

[MS912xIdd_Install.HW]
AddReg = MS912xIdd_HwAddReg

[MS912xIdd_HwAddReg]
; Required by IddCx.
HKR,,"UpperFilters",0x00010000,"IndirectKmd"

[MS912xIdd_Install.Services]
AddService = WUDFRd, 0x000001fa, WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = %WudfRdDisplayName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\WUDFRd.sys
LoadOrderGroup = Base

[MS912xIdd_Install.Wdf]
UmdfService                = ms912xidd, MS912xIdd_UmdfInstall
UmdfServiceOrder           = ms912xidd
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy       = AllowNullAndUnknownFileObjects
; Its own host process, so a crash here cannot take other drivers down, and
; impersonation so the host can open the HID and WinUSB device interfaces.
UmdfHostProcessSharing     = ProcessSharingDisabled
UmdfImpersonationLevel     = Impersonation

[MS912xIdd_UmdfInstall]
UmdfLibraryVersion = 2.33.0
ServiceBinary      = %13%\ms912xidd.dll
UmdfExtensions     = IddCx0102

[Strings]
ProviderName      = "winusbdisplay"
ManufacturerName  = "MacroSilicon"
DeviceName        = "MacroSilicon USB Display (indirect display driver)"
DiskName          = "MacroSilicon USB Display Installation Disk"
WudfRdDisplayName = "Windows Driver Foundation - User-mode Driver Framework Reflector"
